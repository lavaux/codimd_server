#!/usr/bin/env node

// First configure the logger, so it does not spam the console
const logger = require('../lib/logger')
logger.transports.forEach((transport) => transport.level = 'warning')

const models = require('../lib/models/')
const readline = require('readline-sync')
const minimist = require('minimist')
const { ValidationError } = require('sequelize')

function showUsage (tips) {
  console.log(`${tips}

Command-line utility to create users for email-signin.

Usage: bin/manage_users [--pass password] (--add | --del | --reset) user-email
       bin/manage_users (--adduser | --deluser | --superuser) profileid
       bin/manage_users --list
	Options:
		--add 	Add user with the specified user-email
		--del 	Delete user with specified user-email
		--reset Reset user password with specified user-email
		--pass	Use password from cmdline rather than prompting
		--adduser Create an empty user with profileid
		--deluser Delete user with profileid
		--superuser Set user with profileid as a superuser
		--list	List the profileids of all users
`)
  process.exit(1)
}

function getPass (argv, action) {
  // Find whether we use cmdline or prompt password
  if (typeof argv['pass'] !== 'string') {
    return readline.question(`Password for ${argv[action]}:`, { hideEchoBack: true })
  }
  console.log('Using password from commandline...')
  return argv['pass']
}

async function createUserProf (argv) {
  const existing_user = await models.User.findOne({ where: { profileid: argv['adduser'] } })
  // Cannot create already-existing users
  if (existing_user) {
    console.log(`User with profileid ${existing_user.profileid} already exists! Aborting ...`)
    process.exit(2)
  }

  await models.User.create({ profileid: argv['adduser'] })
  console.log(`Created user with profileid ${argv['adduser']}`)
}

// Using an async function to be able to use await inside
async function createUser (argv) {
  const existing_user = await models.User.findOne({ where: { email: argv['add'] } })
  // Cannot create already-existing users
  if (existing_user) {
    console.log(`User with e-mail ${existing_user.email} already exists! Aborting ...`)
    process.exit(2)
  }

  const pass = getPass(argv, 'add')
  if (pass.length === 0) {
    console.log('Password cannot be empty!')
    process.exit(1)
  }

  // Lets try to create, and check success
  try {
    const ref = await models.User.create({ email: argv['add'], password: pass })
    if (ref === undefined) {
      console.log(`Could not create user with email ${argv['add']}`)
      process.exit(1)
    } else {
      console.log(`Created user with email ${argv['add']}`)
    }
  } catch (err) {
    if (err instanceof ValidationError) {
      console.log('Could not create user, since the email address is invalid.')
      process.exit(1)
    } else {
      throw err
    }
  }
}

async function setSuperUser (argv) {
  const existing_user = await models.User.findOne({ where: { profileid: argv['superuser'] } })
  if (!existing_user) {
    console.log(`User with profileid ${argv['superuser']} does not exist`)
    process.exit(1)
  }

  existing_user.superuser = true
  await existing_user.save()
  console.log(`User ${argv['superuser']} is now a superuser`)
}

async function listUsers (argv) {
  const existing_users = await models.User.findAll()
  if (existing_users.length === 0) {
    console.log('No users in DB')
    process.exit(1)
  }

  existing_users.forEach(user => console.log(user.profileid))
}

// Using an async function to be able to use await inside
async function deleteUser (argv) {
  // Cannot delete non-existing users
  const existing_user = await models.User.findOne({ where: { email: argv['del'] } })
  if (!existing_user) {
    console.log(`User with e-mail ${argv['del']} does not exist, cannot delete`)
    process.exit(1)
  }

  // Sadly .destroy() does not return any success value with all
  // backends. See sequelize #4124
  await existing_user.destroy()
  console.log(`Deleted user ${argv['del']} ...`)
}

// Using an async function to be able to use await inside
async function deleteUserProf (argv) {
  // Cannot delete non-existing users
  const existing_user = await models.User.findOne({ where: { profileid: argv['deluser'] } })
  if (!existing_user) {
    console.log(`User with profileid ${argv['deluser']} does not exist, cannot delete`)
    process.exit(1)
  }

  // Sadly .destroy() does not return any success value with all
  // backends. See sequelize #4124
  await existing_user.destroy()
  console.log(`Deleted user ${argv['deluser']} ...`)
}

// Using an async function to be able to use await inside
async function resetUser (argv) {
  const existing_user = await models.User.findOne({ where: { email: argv['reset'] } })
  // Cannot reset non-existing users
  if (!existing_user) {
    console.log(`User with e-mail ${argv['reset']} does not exist, cannot reset`)
    process.exit(1)
  }

  // set password and save
  existing_user.password = getPass(argv, 'reset')
  await existing_user.save()
  console.log(`User with email ${argv['reset']} password has been reset`)
}

const options = {
  add: createUser,
  del: deleteUser,
  reset: resetUser,
  adduser: createUserProf,
  deluser: deleteUserProf,
  superuser: setSuperUser,
  list: listUsers
}

// options that take no value
const flagOptions = ['list']

// Perform commandline-parsing and always treat values as strings, so that
// numeric profileids are not converted to numbers
const argv = minimist(process.argv.slice(2), { string: ['pass', ...Object.keys(options).filter(key => !flagOptions.includes(key))] })

const keys = Object.keys(options)
const opts = keys.filter((key) => argv[key] !== undefined)
const action = opts[0]

// Check for options missing
if (opts.length === 0) {
  showUsage(`You did not specify either ${keys.map((key) => `--${key}`).join(' or ')}!`)
}

// Check if both are specified
if (opts.length > 1) {
  showUsage(`You cannot ${opts.join(' and ')} at the same time!`)
}
// Check if not string
if (!flagOptions.includes(action) && (typeof argv[action] !== 'string' || argv[action] === '')) {
  showUsage(`You must follow an email or profileid after --${action}`)
}

// Call respective processing functions
options[action](argv).then(function () {
  process.exit(0)
}).catch(err => {
  console.error('An error occurred:', err)
  process.exit(1)
})
